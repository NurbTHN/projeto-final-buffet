# BUFFET MANAGER — CONFIGURAÇÕES DE AMBIENTE (MODELO)
# Copie este arquivo para .env e preencha com os dados do seu servidor MySQL

# Conexão MySQL 8.x
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=buffet_manager
DB_CONNECTION_LIMIT=10

# Modo de Execução: 'mysql' ou 'sqlite'
DB_DRIVER=mysql

# Ambiente da Aplicação
NODE_ENV=development

# Conta inicial criada apenas se a tabela usuarios estiver vazia
ADMIN_INITIAL_EMAIL=admin@buffet.local
ADMIN_INITIAL_PASSWORD=AltereEstaSenhaForte123!

# E-mail real: configure Resend OU SMTP
RESEND_API_KEY=
EMAIL_FROM=Buffet Manager <no-reply@seudominio.com>
# Alternativa SMTP
SMTP_HOST=localhost 
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
